{
	// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
	// wrangler.jsonc — Cloudflare Worker Configuration
	// This file tells Cloudflare HOW to run your Next.js app.
	// Wrangler is Cloudflare's CLI tool (like a deployment toolkit).
	// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

	// Wrangler's own JSON schema for auto-completion in VS Code
	"$schema": "node_modules/wrangler/config-schema.json",

	// Entry point: the compiled worker file (auto-generated by `npm run deploy`)
	"main": ".open-next/worker.js",

	// ⚠️ IMPORTANT: This is your Cloudflare Worker name.
	// It will appear in your Cloudflare dashboard and determines the URL:
	// https://divalino.your-account.workers.dev
	"name": "divalino",

	// The date when you set up — Cloudflare uses this to determine
	// which platform features and APIs your worker can use.
	"compatibility_date": "2026-05-09",

	// Feature flags that unlock capabilities in your worker:
	// - nodejs_compat: Lets your worker use Node.js APIs (required for Next.js)
	// - global_fetch_strictly_public: Makes fetch() behave securely
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],

	// Your static assets (CSS, images, JS files) are stored here after build.
	// Cloudflare serves these directly from its CDN — super fast!
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	"services": [
		{
			// This allows the worker to call itself — used for caching.
			// The service name MUST match the "name" field above.
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "divalino"
		}
	],

	"images": {
		// Enables Cloudflare's built-in image optimization.
		// This means Next.js <Image> components are optimized on Cloudflare's edge.
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}